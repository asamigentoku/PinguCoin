PORT=8081

# Set this in staging to make every API use the same Supabase `postgres` DB.
# When set, DATABASE_URL takes precedence over the DB_* values below.
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=payment
DB_SSLMODE=disable

# pingu-apiからのgRPC呼び出しを検証する共有シークレット。
# pingu-api/orcan-api/payment-apiで同じ値を設定する。
INTERNAL_API_TOKEN=

PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=orcan
DB_SSLMODE=disable

# pingu-apiからのgRPC呼び出しを検証する共有シークレット。
# pingu-api/orcan-api/payment-apiで同じ値を設定する。
INTERNAL_API_TOKEN=

# 商品画像・ファイルを保存するAzure Blob Storage。
# 未設定ならAzurite(ローカル開発用エミュレーター)標準の開発用アカウントに接続する。
# AZURE_STORAGE_CONNECTION_STRING=

# 商品画像(main_image/sub_images)用。Blob単位で匿名読み取りを許可する公開コンテナ。
AZURE_STORAGE_PUBLIC_CONTAINER=pingue-public
# 商品ファイル(販売対象のデジタルコンテンツ)用。非公開コンテナ(閲覧には署名付きURLが必要)。
AZURE_STORAGE_PRIVATE_CONTAINER=pingue

# Blobパス("{APP_ENV}/products/{user_id}/{product_id}/...")に使う環境名。
APP_ENV=develop

PORT=8082

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pingu
DB_SSLMODE=disable

ORCAN_API_ADDR=localhost:8080
PAYMENT_API_ADDR=localhost:8081

# Clerk Dashboard > API Keys の Secret Key。
# セッショントークンの検証(JWKS取得)とユーザープロフィール取得(Backend API)に使う。

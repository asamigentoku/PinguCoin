# Server-side base URL for the nginx entry point in local development.
BFF_API_URL=http://localhost:8082/api/v1
# Browser/CDN path. In local development Next.js rewrites this path to BFF_API_URL.
NEXT_PUBLIC_BFF_API_URL=/api/v1

# Optional. MyMemory recommends an email for production/high-volume API usage.
MYMEMORY_EMAIL=

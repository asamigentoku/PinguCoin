PORT=8080

# Set this in staging to make every API use the same Supabase `postgres` DB.
# When set, DATABASE_URL takes precedence over the DB_* values below.
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=orcan
DB_SSLMODE=disable

# pingu-apiからのgRPC呼び出しを検証する共有シークレット。
# pingu-api/orcan-api/payment-apiで同じ値を設定する。
INTERNAL_API_TOKEN=

# 商品画像・ファイルを保存するAzure Blob Storage。
# 未設定ならAzurite(ローカル開発用エミュレーター)標準の開発用アカウントに接続する。
# AZURE_STORAGE_CONNECTION_STRING=

# 商品画像(main_image/sub_images)用。Blob単位で匿名読み取りを許可する公開コンテナ。
AZURE_STORAGE_PUBLIC_CONTAINER=pingue-public
# 商品ファイル(販売対象のデジタルコンテンツ)用。非公開コンテナ(閲覧には署名付きURLが必要)。
AZURE_STORAGE_PRIVATE_CONTAINER=pingue

# Blobパス("{APP_ENV}/products/{user_id}/{product_id}/...")に使う環境名。
APP_ENV=develop

# 商品の読み取りキャッシュ(Redis)。true で有効、false(既定)で無効(常に DB から読む)。
# 切り替えたあとは、orcan-api を再起動する。Redis が落ちていても、APIは止まらず DB から読む。
REDIS_ENABLED=false
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0
# キャッシュの有効期間。商品の更新時は明示的に消すので、これは消し損ねたときの上限。
# REDIS_PRODUCT_CACHE_TTL=60s

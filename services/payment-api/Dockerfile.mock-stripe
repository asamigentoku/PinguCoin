FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY services/payment-api ./services/payment-api
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/mock-stripe ./services/payment-api/cmd/mock-stripe

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/mock-stripe /mock-stripe
EXPOSE 8090
ENTRYPOINT ["/mock-stripe"]

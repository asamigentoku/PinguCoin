PORT=8082

MEDIA_API_ADDR=localhost:8080
INVENTORY_API_ADDR=localhost:8083
ORDER_API_ADDR=localhost:8084
PAYMENT_API_ADDR=localhost:8081

# Clerk Dashboard > API Keys の Secret Key。
# セッショントークンの検証(JWKS取得)とユーザープロフィール取得(Backend API)に使う。
